# Pixelle-Video Web UI (Streamlit). Installed by deploy/instabox/install.sh;
# __INSTALL_DIR__, __USER__ and __MODEL_DIR__ are substituted at install time.
[Unit]
Description=Pixelle-Video Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
# instabox exports Org Secret placeholders here (boot services get no login shell)
EnvironmentFile=-/run/instabox/env/env
EnvironmentFile=-__INSTALL_DIR__/secrets.env
Environment=PIXELLE_MODEL_DIR=__MODEL_DIR__
Environment=PIXELLE_CHROMIUM_PATH=/usr/bin/chromium
# Keep Playwright browsers off the shared instabox desktop
Environment=INSTABOX_HEADLESS=1
# Load the segmentation model in the background at startup (first request stays fast)
Environment=PIXELLE_SEGMENTATION_WARMUP=1
Environment=PYTHONUNBUFFERED=1
ExecStart=__INSTALL_DIR__/.venv/bin/streamlit run web/app.py \
    --server.address 127.0.0.1 --server.port 8501 --server.headless true \
    --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5
# Leave room for llama-server / freellmapi on an 8 GiB machine
MemoryHigh=2500M
MemoryMax=3500M
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
