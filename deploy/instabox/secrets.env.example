# Copy to secrets.env (chmod 600) and fill in. Never commit secrets.env.
# Leave a line empty if the value comes from instabox Org Secrets instead.

# freellmapi unified API key (freellmapi dashboard -> Keys page header)
FREELLMAPI_API_KEY=

# Optional: model name exposed by freellmapi (default "auto")
# PIXELLE_LLM_MODEL=auto

# Cloudflare Workers AI (token needs the Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
