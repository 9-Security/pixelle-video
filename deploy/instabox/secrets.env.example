# Copy to secrets.env (chmod 600) and fill in. Never commit secrets.env.
# Leave a line empty if the value comes from instabox Org Secrets instead.

# LLM API key. Default provider is Google Gemini (aistudio.google.com/apikey).
PIXELLE_LLM_API_KEY=

# Optional overrides (defaults: Gemini OpenAI-compatible endpoint, gemini-flash-latest)
# PIXELLE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# PIXELLE_LLM_MODEL=gemini-flash-latest
# freellmapi instead: PIXELLE_LLM_BASE_URL=http://127.0.0.1:3001/v1, PIXELLE_LLM_MODEL=auto

# Cloudflare Workers AI (token needs the Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
