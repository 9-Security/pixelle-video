# Loop streamer configuration (copy to /etc/loop-streamer/stream.env, chmod 600).
# Never commit the real file. The stream key is a secret: anyone with it can broadcast on your channel.

# YouTube Studio -> Go live -> Stream -> "Stream key" (use a persistent key)
YOUTUBE_STREAM_KEY=

# Directory with program .mp4 files built by `python -m pixelle_video.loops program ...`
STREAM_LIBRARY=/srv/loop-streamer/programs

# Optional: backup ingest or plain RTMP (port 1935) if 443 is blocked
# STREAM_INGEST_URL=rtmp://a.rtmp.youtube.com/live2
